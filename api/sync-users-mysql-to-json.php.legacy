<?php
/**
 * Sync MySQL users → auth.php users.json
 * Chạy sau khi migrate để auth.php có thể thấy tất cả users
 */
date_default_timezone_set('Asia/Ho_Chi_Minh');
header('Content-Type: text/plain; charset=utf-8');
ini_set('display_errors', 1);
error_reporting(E_ALL);

require_once __DIR__ . '/db.php';

echo "=== Sync MySQL users → auth.php users.json ===\n\n";

// Đọc users từ MySQL
$mysqlUsers = DB::select("SELECT * FROM users ORDER BY id");
echo "✅ MySQL users: " . count($mysqlUsers) . "\n";

// Đọc users.json hiện tại
$jsonPath = __DIR__ . '/data/users.json';
$existingUsers = file_exists($jsonPath) ? json_decode(file_get_contents($jsonPath), true) : [];
echo "✅ JSON users hiện tại: " . count($existingUsers) . "\n\n";

// Build map email → id từ JSON
$jsonEmailMap = [];
foreach ($existingUsers as $u) {
    $jsonEmailMap[$u['email'] ?? ''] = $u['id'] ?? '';
}

$created = 0;
$updated = 0;
$originalCount = count($existingUsers);

foreach ($mysqlUsers as $mu) {
    $email = $mu['email'] ?? '';
    if (!$email) continue;

    $jsonUser = [
        'id' => 'u-' . substr(md5($email), 0, 16),
        'email' => $email,
        'password' => $mu['password_hash'] ?? '',
        'role' => strtoupper($mu['role'] ?? 'student'),
        'fullName' => $mu['full_name'] ?? '',
        'phone' => $mu['phone'] ?? '',
        'status' => strtoupper($mu['status'] ?? 'active'),
        'courseId' => '',
        'rank' => '',
        'address' => '',
        'notes' => 'Synced from MySQL',
        'createdAt' => $mu['created_at'] ?? date('c'),
    ];

    if (isset($jsonEmailMap[$email])) {
        // Update existing - BUT always update password từ MySQL
        foreach ($existingUsers as &$eu) {
            if (($eu['email'] ?? '') === $email) {
                $eu['role'] = $jsonUser['role'];
                $eu['status'] = $jsonUser['status'];
                $eu['fullName'] = $jsonUser['fullName'];
                $eu['phone'] = $jsonUser['phone'];
                // Luôn lấy password hash từ MySQL làm nguồn đúng
                if (!empty($mu['password_hash'])) {
                    $eu['password'] = $mu['password_hash'];
                }
                $updated++;
                echo "  🔄 Updated: {$email} (role: {$jsonUser['role']}, hasPassword: " . (!empty($eu['password']) ? 'YES' : 'NO') . ")\n";
                break;
            }
        }
        unset($eu);
    } else {
        $existingUsers[] = $jsonUser;
        $jsonEmailMap[$email] = $jsonUser['id'];
        $created++;
        echo "  ✅ Created: {$email} (role: {$jsonUser['role']}, name: {$jsonUser['fullName']})\n";
    }
}

// Build map email từ MySQL để xóa users không còn tồn tại
$mysqlEmails = [];
foreach ($mysqlUsers as $mu) {
    $email = $mu['email'] ?? '';
    if ($email) $mysqlEmails[$email] = true;
}

// === XÓA users không còn trong MySQL ===
// Bảo vệ các role quan trọng (Admin, Staff, Teacher, Accountant) không bị xóa bởi sync
$protectedRoles = ['ADMIN', 'STAFF', 'TEACHER', 'ACCOUNTANT'];
$removed = 0;
$existingUsers = array_values(array_filter($existingUsers, function($u) use ($mysqlEmails, $protectedRoles) {
    $email = $u['email'] ?? '';
    $role = strtoupper($u['role'] ?? '');

    // KHÔNG xóa user có role được bảo vệ, ngay cả khi không có trong MySQL
    if (in_array($role, $protectedRoles)) {
        return true;
    }

    if (!isset($mysqlEmails[$email])) {
        echo "  🗑️  Removed: {$email} (không còn trong MySQL)\n";
        return false;
    }
    return true;
}));
// Reset keys
$existingUsers = array_values($existingUsers);
if (count($existingUsers) < $originalCount) {
    $removed = $originalCount - count($existingUsers);
}

// Lưu users.json
$tmp = $jsonPath . '.tmp.' . getmypid();
$json = json_encode($existingUsers, JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT);
if ($json === false) die("❌ JSON encode failed: " . json_last_error_msg() . "\n");

if (!file_put_contents($tmp, $json, LOCK_EX)) die("❌ Write failed\n");
if (!rename($tmp, $jsonPath)) { @unlink($tmp); die("❌ Rename failed\n"); }

echo "\n=== KẾT QUẢ ===\n";
echo "✅ Created: {$created} users\n";
echo "🔄 Updated: {$updated} users\n";
echo "🗑️  Removed: {$removed} users\n";
echo "📊 Total JSON users: " . count($existingUsers) . "\n";
echo "✅ Đồng bộ hoàn tất! auth.php giờ có thể thấy tất cả users từ MySQL.\n";
